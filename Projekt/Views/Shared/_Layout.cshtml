@using Microsoft.AspNetCore.Http
@{
    var username = Context.Session.GetString("Username");
    var user_role = Context.Session.GetString("User_role");
    var user_action = user_role ?? "Customer";
}

<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zásilkovna</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">📦 Zásilkovna</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        @if (!string.IsNullOrEmpty(username))
                        {
                            <li class="nav-item">
                                <a class="nav-link"asp-area="User" asp-controller="User" asp-action="@user_action">
                                    👤 @username
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Account" asp-controller="Account" asp-action="Logout">Odhlásit</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Account" asp-controller="Account" asp-action="Login">Přihlášení</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Account" asp-controller="Account" asp-action="Register">Registrace</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="bg-light text-center text-muted py-3 mt-5">
        <small>© 2025 Zásilkovna – všechny práva vyhrazeny</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
