@{
    ViewData["Title"] = "Domů";
}

<div class="text-center">
    <h1 class="display-3 mb-3">Vítejte v Zásilkovně</h1>
    <p class="lead">Rychlé, spolehlivé a dostupné doručení balíků po celé České republice.</p>
</div>

<div class="row mt-5">
    <div class="col-md-4 text-center">
        <img src="https://cdn-icons-png.flaticon.com/512/1048/1048940.png" width="100" />
        <h3 class="mt-3">Snadné podání</h3>
        <p>Zadejte svůj balík během pár minut přes web nebo mobilní aplikaci.</p>
    </div>
    <div class="col-md-4 text-center">
        <img src="https://cdn-icons-png.flaticon.com/512/578/578022.png" width="100" />
        <h3 class="mt-3">Rychlé doručení</h3>
        <p>Balík doručíme obvykle do druhého dne na vybrané místo.</p>
    </div>
    <div class="col-md-4 text-center">
        <img src="https://cdn-icons-png.flaticon.com/512/554/554857.png" width="100" />
        <h3 class="mt-3">Sledování online</h3>
        <p>Mějte přehled, kde se váš balík právě nachází.</p>
    </div>
</div>

<div class="mt-5 p-5 bg-primary text-white text-center rounded">
    <h2>Přidejte se k nám!</h2>
    <p>Zaregistrujte se a využívejte všechny výhody naší služby.</p>
    <a class="btn btn-light btn-lg" asp-area="Account" asp-controller="Account" asp-action="Register">Registrovat</a>
</div>
