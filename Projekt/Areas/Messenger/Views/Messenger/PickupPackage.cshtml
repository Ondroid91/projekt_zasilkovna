@using Domain.Entities
@model IEnumerable<Package>

@{
    ViewData["Title"] = "Moje balíčky";
    var hasPackages = ViewBag.HasPackages ?? false;
}

<div class="container mt-4">
    <h2>📦 Balíčky k vyzvednutí</h2>

    @if (!hasPackages)
    {
        <p>Nemáte žádné balíčky k vyzvednutí.</p>
    }
    else
    {
        <table class="table table-striped mt-3">
            <thead>
                <tr>
                    <th>Název</th>
                    <th>Váha (kg)</th>
                    <th>Odesílací adresa</th>
                    <th>Skladiště</th>
                    <th>Doručovací adresa</th>
                    <th>Stav</th>
                    <th>Převzít</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.Weight.ToString("F2")</td>
                        <td>@($"{p.PickupAddress?.Street}, {p.PickupAddress?.City}, {p.PickupAddress?.Zipcode}")</td>
                        <td>
                            @(p.StorageAddress != null
                                                ? $"{p.StorageAddress.Street}, {p.StorageAddress.City}, {p.StorageAddress.Zipcode}"
                                                : "Nepřiřazeno")
                </td>
                <td>@($"{p.DeliveryAddress?.Street}, {p.DeliveryAddress?.City}, {p.DeliveryAddress?.Zipcode}")</td>
                <td>
                    @{
                                string statusCz = p.Status switch
                                {
                                    "created" => "Vytvořeno",
                                    "to_pickup" => "K vyzvednutí",
                                    "stored" => "Uskladněno",
                                    "in_delivery" => "V doručení",
                                    "delivered" => "Doručeno",
                                    "canceled" => "Zrušeno",
                                    _ => p.Status
                                };
                            }
                            @statusCz
                        </td>
                        <td>
                            @* Tlačítko Převzít *@
                            @if (p.Status == "to_pickup")
                            {
                                <form asp-action="OnPickup" method="post" class="d-inline">
                                    <input type="hidden" name="packageId" value="@p.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm">📦 Převzít</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-4">
        <a asp-area="User" asp-controller="User" asp-action="Messenger" class="btn btn-secondary">Zpět</a>
    </div>
</div>
