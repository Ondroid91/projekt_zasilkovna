@using Domain.Entities
@model IEnumerable<Address>

@{
    ViewData["Title"] = "Nová zásilka";
}

<div class="container mt-5">
    <h3 class="mt-5">➕ Vytvořit novou zásilku</h3>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger mt-3">
            @ViewBag.ErrorMessage
        </div>
    }

    <form method="post" asp-action="OnCreatePackage" class="mt-3">
        <div class="row g-3">

            <div class="col-md-6">
                <h5>📍 Odesílací adresa</h5>
                <select name="pickupAddressId" class="form-select mb-2" required>
                    <option value="">-- Vyber adresu --</option>
                    @foreach (var address in Model)
                    {
                        <option value="@address.Id">@address.Street, @address.City, @address.Zipcode</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <h5>🏠 Doručovací adresa</h5>
                <select name="deliveryAddressId" class="form-select mb-2" required>
                    <option value="">-- Vyber adresu --</option>
                    @foreach (var address in Model)
                    {
                        <option value="@address.Id">@address.Street, @address.City, @address.Zipcode</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <input type="number" step="0.01" min="0" name="weight" class="form-control" placeholder="Hmotnost (kg)" required />
            </div>

            <div class="col-md-9">
                <input type="text" name="name" class="form-control" placeholder="Poznámka (nepovinné)" />
            </div>

            <div class="col-md-12 text-end mt-3">
                <button type="submit" class="btn btn-success">📦 Odeslat zásilku</button>
            </div>
        </div>
    </form>

    <div class="mt-4">
        <a asp-area="User" asp-controller="User" asp-action="Customer" class="btn btn-secondary">Zpět</a>
    </div>
</div>
