@using Domain.Entities
@model IEnumerable<User>

@{
    ViewData["Title"] = "Správa uživatelů";
    var warehouses = ViewBag.Warehouses as IEnumerable<Warehouse> ?? Enumerable.Empty<Warehouse>();
    var errorMessage = ViewBag.ErrorMessage as string;
}

<div class="container mt-5">
    <h2 class="mb-4">👤 Správa uživatelů</h2>

    @* Zobrazení chyby, pokud nějaká existuje *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Jméno</th>
                <th>E-mail</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Phone</td>
                    <td>@user.Role</td>
                    <td>
                        @if (user.Role != "Admin")
                        {
                            <form method="post" asp-action="DeleteUser" asp-route-id="@user.Id" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Smazat</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="mt-5">➕ Přidat nového uživatele</h3>

    <form method="post" asp-action="CreateUser" class="mt-3">
        <div class="row g-3">
            <div class="col-md-3">
                <input type="text" name="username" class="form-control" placeholder="Uživatelské jméno" required />
            </div>

            <div class="col-md-3">
                <input type="email" name="email" class="form-control" placeholder="E-mail" />
            </div>

            <div class="col-md-2">
                <input type="text" name="phone" class="form-control" placeholder="Telefon" />
            </div>

            <div class="col-md-3">
                <input type="password" name="password" class="form-control" placeholder="Heslo" required />
            </div>

            <div class="col-md-2">
                <select name="role" class="form-select" required>
                    <option value="Customer">Zákazník</option>
                    <option value="Messenger">Kurýr</option>
                    <option value="Warehouseman">Skladník</option>
                </select>
            </div>

            <div class="col-md-3">
                <select name="warehouseId" class="form-select">
                    <option value="">-- Vyber pracoviště --</option>
                    @foreach (var warehouse in warehouses)
                    {
                        <option value="@warehouse.Id">@warehouse.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
                <button type="submit" class="btn btn-success w-100">Přidat</button>
            </div>
        </div>
    </form>

    <div class="mt-4">
        <a asp-area="User"  asp-controller="User" asp-action="Admin" class="btn btn-secondary">Zpět</a>
    </div>
</div>
