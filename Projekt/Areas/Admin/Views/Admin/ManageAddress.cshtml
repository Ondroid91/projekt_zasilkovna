@using Domain.Entities
@model IEnumerable<Address>

@{
    ViewData["Title"] = "Správa adres";
}

<div class="container mt-5">
    <h2 class="mb-4">📍 Správa adres</h2>

    <form method="get" asp-controller="Admin" asp-action="ManageAddress" class="mb-3">
        <label for="sortBy">Seřadit podle:</label>
        <select name="sortBy" id="sortBy"
                onchange="this.form.submit()"
                class="form-select w-auto d-inline-block ms-2">
            <option value="id">ID</option>
            <option value="street">Ulice</option>
            <option value="city">Město</option>
            <option value="zipcode">PSČ</option>
        </select>
    </form>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Ulice</th>
                <th>Město</th>
                <th>PSČ</th>
                <th>Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var address in Model)
            {
                <tr>
                    <td>@address.Id</td>
                    <td>@address.Street</td>
                    <td>@address.City</td>
                    <td>@address.Zipcode</td>
                    <td>
                        <form method="post"
                              asp-controller="Admin"
                              asp-action="DeleteAddress"
                              asp-route-id="@address.Id"
                              style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm">
                                Smazat
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger mt-3">
            @ViewBag.ErrorMessage
        </div>
    }

    <h3 class="mt-5">➕ Přidat novou adresu</h3>

    <form method="post"
          asp-controller="Admin"
          asp-action="CreateAddress"
          class="mt-3">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text"
                       name="street"
                       class="form-control"
                       placeholder="Ulice"
                       required />
            </div>

            <div class="col-md-4">
                <input type="text"
                       name="city"
                       class="form-control"
                       placeholder="Město"
                       required />
            </div>

            <div class="col-md-2">
                <input type="text"
                       name="zipcode"
                       class="form-control"
                       placeholder="PSČ"
                       required />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100">
                    Přidat
                </button>
            </div>
        </div>
    </form>

    <div class="mt-4">
        <a asp-area="User"  asp-controller="User" asp-action="Admin" class="btn btn-secondary">Zpět</a>
    </div>
</div>
